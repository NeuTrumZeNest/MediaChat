# Copy values into your private .env. Do not commit credentials.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/mediachat
SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000
# In development, allow localhost + current private IPv4 interfaces automatically.
APP_ALLOW_LAN=true
# Optional extra exact origins, comma separated; no paths or wildcards.
# APP_ALLOWED_ORIGINS=http://192.168.1.20:3000,https://chat.example.com
# For production/tunnel, configure the exact public origin. share script sets it itself.
# APP_ORIGIN=https://chat.example.com
